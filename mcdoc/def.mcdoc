
type PlacerItem = ::java::world::item::SingleItem

struct CommonIn {
    place_command: #[command] string,
    place_data?: any,
    item_components?: ::java::world::component::DataComponentPatch,
}

enum(byte) AxisRotation {
    PosX = 0b,
    NegX = 1b,
    PosY = 2b,
    NegY = 3b,
    PosZ = 4b,
    NegZ = 5b,
}

