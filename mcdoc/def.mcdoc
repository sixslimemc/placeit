
type PlacerItem = ::java::world::item::SingleItem
type PlaceCommand = #[command] string
type PlaceData = any

struct ItemInput {
    place: struct {
        command: PlaceCommand,
        data?: PlaceData,
    },
    components?: ::java::world::component::DataComponentPatch
}

enum(byte) BlockFacingDirection {
    PosX = 0b,
    NegX = 1b,
    PosY = 2b,
    NegY = 3b,
    PosZ = 4b,
    NegZ = 5b,
}

