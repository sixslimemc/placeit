
struct VariableRegister {
    [string]: any
}
dispatch minecraft:storage[placeit:_] to struct {
    /// top level
    t: VariableRegister,
    /// impl
    v: VariableRegister,
    /// util
    u: VariableRegister,
    /// in-scope temp
    x: VariableRegister,
    // for reentrant functions
    eval: [struct {
        in: any,
        out: any,
        v: VariableRegister,
    }],
}
dispatch minecraft:storage[placeit:_/in] to struct {
    [any]: any
}
dispatch minecraft:storage[placeit:_/out] to struct {
    [any]: any
}